#!/usr/bin/env bash
#
# Launcher for VS Code Spaces with Resource Optimization Engine
# Usage:
#   ./code-spaces             # Launch with default / last session
#   ./code-spaces <folder>    # Launch with a specific repository folder

export VSCODE_SKIP_NODE_VERSION_CHECK=1
export VSCODE_SKIP_PRELAUNCH=1
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Ensure user settings have Spaces settings enabled in both dev paths
for USER_SETTINGS in "$HOME/Library/Application Support/code-oss-dev/User/settings.json" "$HOME/.vscode-oss-dev/data/User/settings.json"; do
	mkdir -p "$(dirname "$USER_SETTINGS")"
	if [ ! -f "$USER_SETTINGS" ] || [ "$(cat "$USER_SETTINGS" 2>/dev/null)" = "{}" ] || [ ! -s "$USER_SETTINGS" ]; then
		cat << 'EOF' > "$USER_SETTINGS"
{
	"workbench.experimental.spaces.enabled": true,
	"workbench.experimental.spaces.resourceOptimization": true,
	"workbench.experimental.spaces.autoAdoptWindows": true,
	"workbench.experimental.spaces.restoreOnStartup": true,
	"workbench.experimental.spaces.focusEditorOnSwitch": true,
	"workbench.experimental.spaces.refreshTerminalsOnSwitch": true,
	"window.nativeFullScreen": false
}
EOF
	fi
done

# Pass user extensions directory so all existing VS Code extensions are loaded in Spaces
EXTENSIONS_ARG=""
if [ -d "$HOME/.vscode/extensions" ]; then
	EXTENSIONS_ARG="--extensions-dir=$HOME/.vscode/extensions"
fi

exec "$ROOT/scripts/code.sh" $EXTENSIONS_ARG "$@"
